# The `secrets` pin resolves `secret://name` references from this file at rungs
# 0.5 and 1. Key Vault resolves THE SAME references at rung 3 — the reference
# format never changes, which is what makes that swap roughly forty lines.
#
#   cp .env.example .env      and fill in the values you have
#
# .env is gitignored. Nothing here is ever committed.

# secret://pg-dsn — the rung-0.5 data plane. One Postgres 16 + pgvector.
CINQFLOW_SECRET_PG_DSN=postgresql://localhost:5432/cinqflow

# secret://llm-endpoint and secret://llm-key — the `llm` pin.
# Wave 0 runs a REAL OpenAI-compatible endpoint, because "no evaluation
# threshold may be claimed from Lane 1 (mock) or Lane 2 (replay)" and
# CF-V0-E16-10's gates are Lane 3. Leave these unset and the Lane-3 evals SKIP
# with an explicit message — they never silently pass against a stand-in.
CINQFLOW_SECRET_LLM_ENDPOINT=
CINQFLOW_SECRET_LLM_KEY=

# secret://llm-model-small — classify · extract · rerank
# secret://llm-model-large — generate · reason
# Routing is by TASK CLASS from the profile, never by a model named at a call
# site: a call site naming a model must be edited when the tenant's catalogue
# differs, and rung 3 is meant to be a profile line.
CINQFLOW_SECRET_LLM_MODEL_SMALL=
CINQFLOW_SECRET_LLM_MODEL_LARGE=
