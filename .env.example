# ═════════════════════════════════════════════════════════════════════════════
# cinqflow — THE ONE .env
#
#   cp .env.example .env      and fill in the values you have
#
# Every environment variable the platform reads lives here and nowhere else.
# Two different kinds of thing are in this file, and the difference matters:
#
#   CINQFLOW_SECRET_*   resolved by the `secrets` PIN. A profile says
#                       `secret://pg-dsn`; the pin turns that into
#                       CINQFLOW_SECRET_PG_DSN here at rungs 0.5-1 and into a
#                       Key Vault lookup at rung 3. THE REFERENCE NEVER
#                       CHANGES — that is what makes the swap forty lines.
#
#   everything else     read by docker compose to STAND UP the environment:
#                       image tags, ports, credentials for containers it owns.
#                       The application never reads these.
#
# .env is gitignored. Nothing here is ever committed.
# ═════════════════════════════════════════════════════════════════════════════

# ── which environment ────────────────────────────────────────────────────────
# local | dev | prod. `make up ENV=dev` is what actually selects the overlay;
# this records which environment this .env was filled in for.
#
# THE PROFILE IS NOT HERE ON PURPOSE. Each overlay names its own
# (`profiles/dev.yaml` and so on) because .env is one file shared by all three,
# so a profile named here would be the same profile in every environment — and
# an environment running the wrong profile is an environment pointed at the
# wrong databases while reporting the right name.
CINQFLOW_ENV=local
COMPOSE_PROJECT_NAME=cinqflow

# ── the PLATFORM plane ───────────────────────────────────────────────────────
# The platform's OWN state: registry rows, control tables, the queue, the
# vector store. This socket belongs to the chip, not to the client.
CINQFLOW_PG_PLATFORM_USER=cinqflow
CINQFLOW_PG_PLATFORM_PASSWORD=change-me-platform
CINQFLOW_PG_PLATFORM_DB=cinqflow_platform
CINQFLOW_PG_PLATFORM_PORT=5433

# ── the DATA plane ───────────────────────────────────────────────────────────
# Where the CLIENT's data lives — bronze, silver, gold. A SEPARATE socket, on
# purpose: the platform must be connectable to a warehouse that holds none of
# its own state, or "plug and play" is a slogan. At rung 3 this is Azure
# Database for PostgreSQL / Databricks and these container settings go unused —
# only the DSN below changes.
CINQFLOW_PG_DATA_USER=cinqflow
CINQFLOW_PG_DATA_PASSWORD=change-me-data
CINQFLOW_PG_DATA_DB=cinqflow_data
CINQFLOW_PG_DATA_PORT=5434

# ── secret://… — what the `secrets` pin resolves ─────────────────────────────
# THE PASSWORD IS STORED RAW, AND THE DSNs ARE libpq KEYWORD FORM.
#
# This password contains `/` and `+`. In a `postgresql://user:pass@host/db`
# URI those must be percent-encoded, and the encoded form is NOT the password —
# it is a rendering of it. Keeping both in one .env means keeping one secret in
# two spellings, and compose can interpolate but cannot encode, so
# `postgresql://${USER}:${PASSWORD}@...` silently produces a DSN that decodes
# to something the server never had. That is exactly what happened: the data
# plane's DSN percent-decoded to a password its container had never been given,
# and the platform's worked only by the coincidence of an older volume.
#
# libpq's `host=… password=…` form needs no encoding of any kind, psycopg
# accepts it wherever it accepts a URI, and nothing in this codebase parses a
# DSN as a URL. One spelling, one secret.
# These are the HOST-facing DSNs, so running the backend directly on the
# laptop (`python -m cinqflow.api.local`) works with no change. The compose
# files OVERRIDE both for the containerized backend, which addresses the same
# databases by service name on the compose network. One source of truth, two
# vantage points.
CINQFLOW_SECRET_PG_DSN=host=localhost port=5433 user=cinqflow password=change-me-platform dbname=cinqflow_platform
CINQFLOW_SECRET_DATA_PG_DSN=host=localhost port=5434 user=cinqflow password=change-me-data dbname=cinqflow_data

# secret://llm-endpoint and secret://llm-key — the `llm` pin.
# Wave 0 runs a REAL OpenAI-compatible endpoint, because "no evaluation
# threshold may be claimed from Lane 1 (mock) or Lane 2 (replay)". Leave these
# unset and the Lane-3 evals SKIP with an explicit message — they never
# silently pass against a stand-in.
CINQFLOW_SECRET_LLM_ENDPOINT=
CINQFLOW_SECRET_LLM_KEY=

# secret://llm-model-small — classify · extract · rerank
# secret://llm-model-large — generate · reason
# Routing is by TASK CLASS from the profile, never by a model named at a call
# site.
CINQFLOW_SECRET_LLM_MODEL_SMALL=gpt-5-mini
CINQFLOW_SECRET_LLM_MODEL_LARGE=gpt-5

# secret://slack-webhook — the `notification` pin. Approvals only in Wave 1.
CINQFLOW_SECRET_SLACK_WEBHOOK=

# ── the app tier ─────────────────────────────────────────────────────────────
CINQFLOW_BACKEND_PORT=8000
CINQFLOW_FRONTEND_PORT=3000
# What the BROWSER calls. In local/dev this is the published backend port on
# the host; behind an edge in prod it is the public API origin.
CINQFLOW_API=http://127.0.0.1:8000
# Extra requirements layer baked into the backend image. Empty = rung 0.5/1.
#   requirements/agents.txt · requirements/databricks.txt · requirements/azure.txt
CINQFLOW_EXTRA_REQUIREMENTS=
# en_core_web_lg is ~600 MB and is what `phi_scrub` wants. en_core_web_sm
# builds far faster with lower recall; empty leaves the pin unenergized.
CINQFLOW_SPACY_MODEL=en_core_web_lg

# ── the surrounding rung-1 twin (local and dev only) ─────────────────────────
# Prod runs the APP TIER ONLY — every one of these is a managed endpoint there,
# supplied through the *_URL/*_ENDPOINT variables at the bottom of this file.
CINQFLOW_KEYCLOAK_PASSWORD=change-me-keycloak
CINQFLOW_KEYCLOAK_PORT=8081
CINQFLOW_MINIO_USER=cinqflow
CINQFLOW_MINIO_PASSWORD=change-me-minio
CINQFLOW_MINIO_PORT=9000
CINQFLOW_MINIO_CONSOLE_PORT=9001
CINQFLOW_AIRFLOW_PORT=8082
CINQFLOW_GRAFANA_PASSWORD=change-me-grafana
CINQFLOW_GRAFANA_PORT=3001
CINQFLOW_OTLP_GRPC_PORT=4317
CINQFLOW_OTLP_HTTP_PORT=4318
CINQFLOW_VERATO_PORT=1080
CINQFLOW_SFTP_PORT=2222
CINQFLOW_SFTP_PASSWORD=change-me-sftp

# ── rung 3 — external infrastructure (prod) ──────────────────────────────────
# At prod NOTHING above stands up a database, an object store or an identity
# provider. These point the same code at what the client already runs. Unset in
# local and dev, where the twin above supplies them.
CINQFLOW_OIDC_DISCOVERY_URL=
CINQFLOW_STORAGE_ENDPOINT=
CINQFLOW_OTLP_ENDPOINT=
