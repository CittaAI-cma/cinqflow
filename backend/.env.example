# Copy to backend/.env and adjust. All environment difference lives here.
CINQFLOW_DATABASE_URL=postgresql://localhost/cinqflow

# Landing zone root (immutable originals).
# CINQFLOW_LANDING_ROOT=/Users/you/Downloads/CittaAI_Projects/cinqflow/.cinqflow/landing

# Intelligence: `stub` is deterministic and offline; `anthropic`/`openai` call
# a real provider. `openai` uses Structured Outputs, so a fine-tune id works
# the same as its base model (e.g. ft:gpt-4o-2024-08-06:org::id).
CINQFLOW_LLM_PROVIDER=stub
CINQFLOW_LLM_MODEL=claude-sonnet-5
# CINQFLOW_LLM_API_KEY=sk-ant-...

# For CINQFLOW_LLM_PROVIDER=openai:
# CINQFLOW_LLM_MODEL=ft:gpt-4o-2024-08-06:your-org::your-fine-tune-id
# CINQFLOW_LLM_API_KEY=sk-...

# Schemas. `queue` is taken by the previous implementation in this database.
CINQFLOW_WORKFLOW_SCHEMA=workflow
CINQFLOW_QUEUE_SCHEMA=jobq

# Origins allowed to call the API directly from a browser (comma-separated).
# Some frontend client components poll/retry against the API themselves, not
# just server actions - a deployed frontend needs its own public URL listed
# here or the browser blocks those calls, even though the server-rendered
# pages still work fine.
CINQFLOW_CORS_ALLOWED_ORIGINS=http://localhost:3000
