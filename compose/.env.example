# Copy to compose/.env and adjust. Read automatically by `docker compose`
# when run from this directory (or via the Makefile's docker-* targets).

POSTGRES_USER=cinqflow
POSTGRES_PASSWORD=cinqflow
POSTGRES_DB=cinqflow
# Host-side port only (containers always talk to postgres:5432 on the compose
# network). Defaults to 5433 so it does not collide with a local Homebrew
# postgresql@16 already listening on 5432.
POSTGRES_HOST_PORT=5433

API_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

# Intelligence: `stub` is deterministic and offline (default - Stage 1 runs
# end to end with no key); `anthropic`/`openai` call a real provider. `openai`
# uses Structured Outputs, so a fine-tune id works the same as its base model.
CINQFLOW_LLM_PROVIDER=stub
CINQFLOW_LLM_MODEL=claude-sonnet-5
# CINQFLOW_LLM_API_KEY=sk-ant-...

# For CINQFLOW_LLM_PROVIDER=openai:
# CINQFLOW_LLM_MODEL=ft:gpt-4o-2024-08-06:your-org::your-fine-tune-id
# CINQFLOW_LLM_API_KEY=sk-...
# CINQFLOW_LLM_MAX_TOKENS=8000

# Only needed if you changed FRONTEND_HOST_PORT above - the api service's CORS
# allowlist defaults to http://localhost:3000 (settings.cors_allowed_origins).
# CINQFLOW_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Auth (docs/blueprints/auth-and-user-management.md). `jwt_secret` defaults to
# an obviously-fake dev value - set this for real anywhere tokens must not be
# forgeable by anyone who has read settings.py.
# CINQFLOW_JWT_SECRET=change-me-to-a-long-random-value

# Optional: `cinqflow install` creates one administrator from these if no user
# with this email exists yet. Unset once you have a real admin - this is only
# the bootstrap out of "no users at all".
# CINQFLOW_BOOTSTRAP_ADMIN_EMAIL=admin@cinqcare.com
# CINQFLOW_BOOTSTRAP_ADMIN_PASSWORD=change-me
