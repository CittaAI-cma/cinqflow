# Secrets — never committed
compose/.env
backend/.env
*.env
!*.env.example

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/
*.egg-info/

# Node / Next.js
frontend/node_modules/
frontend/.next/
# `next build` from the repo root leaves a stray trace file here too.
.next/

# Runtime data — regenerated by the app, not source
.cinqflow/

# OS
.DS_Store

# Source recordings — the walkthrough derived from them is committed, they are not
docs/blueprints/*.mp4
