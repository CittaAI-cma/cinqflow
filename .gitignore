# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / Next.js
node_modules/
frontend/.next/
frontend/.next-test/
frontend/out/
frontend/next-env.d.ts
frontend/tsconfig.tsbuildinfo

# Secrets — the secrets pin resolves `secret://name`; the values never land here.
.env
.env.*
!.env.example
*.pem
*.key

# Runtime artifacts
/landing/
.cinqflow/
installation-manifest*.json

# ── frontend ────────────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/.next/
frontend/test-results/
frontend/playwright-report/
frontend/next-env.d.ts

# ── twin secrets ──────────────────────────────────────────────────────────────
# Files, never inline values. See compose/secrets/README.md.
compose/secrets/*
!compose/secrets/README.md
test-results/

# ── stray manual-test deliveries at the repo root ────────────────────────────
# Roster samples dropped here while exercising the deliver form; the platform
# reads deliveries from the landing zone, never from the repo root.
/_CINQDOWNSTATE_*

# ── docker ───────────────────────────────────────────────────────────────────
# The secret FILES are projected from .env by compose/bootstrap-env.sh. They
# are the same passwords .env already holds, in the shape a container wants —
# and .env is not committed, so neither are these.
compose/secrets/pg_platform_password
compose/secrets/pg_data_password
.env.backup-*
